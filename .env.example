# Required: OpenAI API key for free-text LLM-as-judge scoring (and for evaluating GPT models)
OPENAI_API_KEY=sk-...

# Optional: override the judge model used to score free-text answers (paper default: gpt-5.4)
# JUDGE_MODEL=gpt-5.4

# Optional: override the model used for MCQ answer-extraction fallback when regex fails
# EXTRACT_MODEL=gpt-4o-mini

# Optional: concurrency tuning
# JUDGE_CONCURRENCY=50
# REQUEST_CONCURRENCY=64
